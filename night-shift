#!/usr/bin/env python3
"""Thin launcher — allows running directly without installing as a package."""

import os
import sys
import warnings

warnings.filterwarnings('ignore', category=DeprecationWarning)

script_dir = os.path.dirname(os.path.abspath(__file__))
if script_dir == '/usr/bin' or not os.path.exists(os.path.join(script_dir, 'night_shift', '__init__.py')):
    sys.path.insert(0, '/usr/lib/night-shift')
else:
    sys.path.insert(0, script_dir)

from night_shift.__main__ import main

main()
